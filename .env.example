# Copy to `.env` and fill in values. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#
# Names must match ApiKeyEnvVar in appsettings.json / env overrides.
# ASP.NET Core binds nested config with double underscores.

# --- LLM API keys (required) ---
DEVCOMMANDER_COMMANDER_API_KEY=
DEVCOMMANDER_PLANNER_API_KEY=
DEVCOMMANDER_CRITIC_API_KEY=

# --- Hyper-Care LLM roles (required for /hc_on fix/triage path) ---
DEVCOMMANDER_TRIAGE_API_KEY=
DEVCOMMANDER_INVESTIGATE_API_KEY=

# --- Grafana (Hyper-Care watchers; name must match config.json grafana.tokenEnvVar) ---
HC_GRAFANA_TOKEN=

# --- Telegram (set Enabled=true for bot ingress) ---
Telegram__Enabled=true
Telegram__BotToken=
# Your chat id from /whoami (add more with __1, __2, ...)
Telegram__AllowedChatIds__0=

# --- Optional ---
# DEVCOMMANDER_PORT=8080
# DevCommander__DefaultBudgetUsd=5.0
# DevCommander__DefaultMissionWallTime=08:00:00
# DevCommander__Agents__Commander__BaseUrl=https://api.openai.com/v1/
# DevCommander__Agents__Commander__Model=gpt-4.1
